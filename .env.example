# Это пример. НЕ загружай реальный токен в этот файл в репозиторий.
# На Amvera надёжнее задавать значения в консоли: «Переменные и секреты».
#
# Для ЛОКАЛЬНОГО запуска вручную скопируй этот файл в .env и заполни.
BOT_TOKEN=
GIRL_NAME=Алина
HER_CHAT_ID=

# Время утреннего комплимента (МСК). По умолчанию 7:00.
MORNING_HOUR=7
MORNING_MINUTE=0

# Опционально: если api.telegram.org недоступен из сети запуска (обычно на Amvera не нужно).
PROXY_URL=